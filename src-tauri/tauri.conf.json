{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nxs",
  "version": "0.1.22",
  "identifier": "com.nxs.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "nxs",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/NicolasGounotEsiea/folda/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5MUYzRjk5QjgxMUM4QzcKUldUSHlCRzRtVDhmMlZ0aUlUL0FyMmcrUW1xRnJuWE0rZUR2UW1iL3BJMk1UUU1NbEw5QUJyR0wK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
